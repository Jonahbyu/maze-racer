; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Maze Racer"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[audio]

driver/output_latency.web=100

[autoload]

Music="*res://scripts/core/Music.gd"
Settings="*res://scripts/core/Settings.gd"

; Leaderboard outlives Shell's scene swaps for the reason the other two do: it is
; written by the game (posting a finished run) and read by the menu (drawing a
; board), and Shell frees the game on the way back to the menu.
; docs/plans/leaderboards.md
Leaderboard="*res://scripts/core/Leaderboard.gd"

[debug]

; The GUI build used by play.ps1 detaches from the console and produces no
; capturable stdout, so a real play session used to leave NO error record at all
; -- while logs/errors.log kept showing whatever a past dev run put there. That
; combination is worse than no log: it reads as "clean" when nothing was
; actually checked. File logging is independent of the console, so it captures
; play sessions too.
;
; The path is user://, NOT res://. logs/ is gitignored, so res://logs does not
; exist in a fresh clone -- and the engine CRASHES (signal 11) on startup when it
; cannot create the log directory, before any script runs. That took down every
; harness in CI. res:// is also read-only in an exported build.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=10

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

